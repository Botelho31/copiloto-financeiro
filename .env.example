# Pluggy API credentials (from your Pluggy dashboard)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Comma-separated Pluggy Item IDs already connected to your bank(s)
PLUGGY_ITEM_IDS=

# Cron schedule for the daily sync (default: 6am every day)
CRON_SCHEDULE=0 6 * * *

# Minimum balance buffer (in your account's currency) below which a projected
# month is flagged as a shortfall
MIN_BUFFER=0

# Notification rule threshold: flag any newly synced transaction at or above
# this amount (BRL)
LARGE_TRANSACTION_THRESHOLD=500

# Pushover: one app-level token for the whole deployment (from
# https://pushover.net/apps/build), paired with each person's own user key
# entered from /config. Leave blank to skip Pushover notifications entirely.
PUSHOVER_APP_TOKEN=

# Email: one SMTP relay for the whole deployment, paired with each person's
# own destination address entered from /config. Leave SMTP_HOST blank to
# skip email notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server
PORT=3000
DB_PATH=./data/budget.sqlite

# Long random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=
