# Pluggy API credentials (from your Pluggy dashboard)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Comma-separated Pluggy Item IDs already connected to your bank(s)
PLUGGY_ITEM_IDS=

# Cron schedule for the daily sync (default: 6am every day)
CRON_SCHEDULE=0 6 * * *

# Minimum balance buffer (in your account's currency) below which a projected
# month is flagged as a shortfall
MIN_BUFFER=0

# Server
PORT=3000
DB_PATH=./data/budget.sqlite

# Long random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=
